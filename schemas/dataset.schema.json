{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/market-structure/dataset/v1",
  "title": "Canonical closed OHLC dataset v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "symbol",
    "timeframe",
    "timezone",
    "timestamp_role",
    "candles",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "timeframe": {
      "type": "string",
      "pattern": "^(M[0-9]+|H[0-9]+|D[0-9]+|OHLC)$"
    },
    "timezone": {
      "const": "UTC"
    },
    "timestamp_role": {
      "const": "candle_open"
    },
    "candles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candle"
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "is_synthetic",
        "source_file",
        "sha256",
        "count",
        "first",
        "last",
        "volume_present",
        "expected_interval_seconds",
        "observed_gaps",
        "provider",
        "timestamp_role_verified"
      ],
      "properties": {
        "is_synthetic": {
          "type": "boolean"
        },
        "source_file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "timestamp_role_verified": {
          "type": "boolean"
        },
        "first": {
          "type": "string",
          "format": "date-time"
        },
        "last": {
          "type": "string",
          "format": "date-time"
        },
        "volume_present": {
          "type": "boolean"
        },
        "expected_interval_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "observed_gaps": {
          "type": "integer",
          "minimum": 0
        },
        "provider": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "candle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "index",
        "source_time"
      ],
      "properties": {
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "source_time": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "open": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "low": {
          "type": "number"
        },
        "close": {
          "type": "number"
        },
        "volume": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
